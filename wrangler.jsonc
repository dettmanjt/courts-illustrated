{
  "name": "courts-illustrated",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ci-crm", "database_id": "cbd8fa30-9259-4de1-a0e2-5916a460ee40" }
  ],
  "vars": {
    "ADMIN_EMAIL": "jt@swcourts.com",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  }
}
