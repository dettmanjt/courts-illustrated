---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Socials from '../../components/Socials.astro';
import { score, initials } from '../../lib/score';

export async function getStaticPaths() {
  const live = new Set((await getCollection('companies', (c) => c.data.published)).map((c) => c.slug));
  const builders = await getCollection('builders', (b) => b.data.published && live.has(b.data.company.slug));
  return builders.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props;
const d = b.data;
const company = await getEntry(d.company);
const c = company.data;
const { Content } = await b.render();
const written = (await getCollection('articles', (a) => a.data.published && a.data.author.slug === b.slug))
  .sort((x, y) => y.data.date.localeCompare(x.data.date));
const TAG: Record<string, string> = { Cost: 't-cost', Comparison: 't-compare', Problems: 't-problems', 'How it works': 't-how' };
const sc = score(d);
const first = d.name.split(' ')[0];
const v = d.verified;
const checks = [
  ['Real person', v.identity, `${d.name}, identity confirmed`, 'Identity check pending'],
  ['Employment', v.employment, `Confirmed with ${c.name}`, 'Confirmation pending'],
  ['Completed projects', v.projects, 'Photos reviewed by Courts Illustrated', 'Photos not yet reviewed'],
  ['License & insurance', v.license, v.checkedOn ? `Checked ${v.checkedOn}` : 'Verified', 'Verification pending'],
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: d.name,
    jobTitle: d.role,
    image: d.photo ? new URL(d.photo, Astro.site).href : undefined,
    url: new URL(`/builders/${b.slug}`, Astro.site).href,
    description: b.body?.trim().split('\n')[0] || undefined,
    worksFor: { '@type': 'HomeAndConstructionBusiness', '@id': new URL(`/companies/${company.slug}#business`, Astro.site).href, name: c.name, url: c.website },
    knowsAbout: c.services,
    hasOccupation: { '@type': 'Occupation', name: 'Court builder', occupationLocation: { '@type': 'Place', name: c.region } },
    sameAs: [d.youtube, ...Object.values(d.socials ?? {})].filter((v, i, a) => v && a.indexOf(v) === i),
  },
  ...(d.faqs.length > 0 && { hasPart: { '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } }),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Courts Illustrated', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/companies/${company.slug}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.name },
    ],
  },
};
---
<Base title={`${d.name}, ${d.role} at ${c.name} | Courts Illustrated`} description={`${d.name} is ${/^[AEIOU]/.test(d.role) ? 'an' : 'a'} ${d.role} at ${c.name}, building courts in ${c.region}.${d.years ? ` ${d.years} years building courts.` : ''}${d.videos ? ` ${d.videos} videos.` : ''} Profile, videos and how to reach them.`} jsonld={jsonld}>
  <div class="mast wrap">
    <div class="eyebrow">Builder Profile · {c.region}</div>
    <h1>{d.name}</h1>
    <p class="role">{d.role} at {c.name}.</p>
    <div class="tiles" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="stats">
      <div><b>{sc.total}</b>CI score</div>
      <div><b>{d.courts}</b>Courts built</div>
      <div><b>{d.years}</b>Years building</div>
      <div><b>{d.certs.length}</b>Certifications</div>
    </div>
  </div>

  <section class="about wrap">
    <div class="sh"><h2>About</h2></div>
    <div class="split">
      <div class="drop-first"><Content /></div>
      <div>
        <div class="portrait">
          {d.photo ? <img src={d.photo} alt={d.name} /> : <span>{initials(d.name)}</span>}
        </div>
        <ul class="facts">
          <li><span>Company</span><a href={`/companies/${company.slug}`}>{c.name}</a></li>
          <li><span>Service area</span>{c.region}</li>
          {d.certs.length > 0 && <li><span>Certifications</span>{d.certs.join(' · ')}</li>}
        </ul>
        <Socials links={{ ...d.socials, youtube: d.youtube ?? d.socials.youtube }} />
        <p class="own">Is this you? <a href={`/update?builder=${b.slug}`}>Request a change</a> · <a href={`/submit?builder=${b.slug}`}>Share a post</a></p>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="sh"><h2>Works at</h2></div>
    <div class="co">
      <div class="co-main">
        <div class="eyebrow">Company · Courts Illustrated</div>
        <h3>{c.name}</h3>
        <p>{c.blurb}</p>
        <div class="co-links">
          <a class="btn" href={`/companies/${company.slug}`}>View company profile</a>
          {c.website && <a class="btn ghost" href={c.website} rel="noopener" target="_blank">Visit {new URL(c.website).hostname} ↗</a>}
        </div>
      </div>
      <ul class="verify" aria-label="What Courts Illustrated verified">
        {checks.map(([label, ok, yes, no]) => (
          <li><span class:list={['ck', { pending: !ok }]} aria-hidden="true"></span><div><b>{label}</b>{ok ? yes : no}</div></li>
        ))}
      </ul>
    </div>
  </section>

  {d.youtube && (
    <section class="wrap">
      <div class="sh"><h2>Videos</h2><a class="more" href={d.youtube} target="_blank" rel="noopener">Open channel ↗</a></div>
      <div class="channel">
        <div><strong>{first} on YouTube</strong></div>
        <a class="btn" href={d.youtube} target="_blank" rel="noopener">Watch on YouTube</a>
      </div>
      {d.videoIds.length > 0 && (
        <div class="vids">
          {d.videoIds.map((id) => (
            <a class="vid" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener" aria-label={`Watch video by ${d.name} on YouTube`}>
              <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
              <span class="play" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      )}
    </section>
  )}
  {(written.length > 0 || d.posts.length > 0) && (
    <section class="wrap" id="articles">
      <div class="sh"><h2>Written by {first}</h2></div>
      {written.length > 0 && (
        <div class="posts">
          {written.map((a) => (
            <a class="post" href={`/articles/${a.slug}`}><span class={`tag ${TAG[a.data.topic]}`}>{a.data.topic}</span><h3>{a.data.title}</h3><p>{a.data.dek}</p><span class="meta">{a.data.sports.join(' · ')}</span></a>
          ))}
        </div>
      )}
      {d.posts.length > 0 && (
        <>
          <h3 class="subh">More from {c.name}</h3>
          <ul class="alist">
            {d.posts.map((a) => <li><a href={a.url} target="_blank" rel="noopener">{a.title}<span aria-hidden="true">↗</span></a>{a.summary && <p class="asum">{a.summary}</p>}</li>)}
          </ul>
        </>
      )}
    </section>
  )}
  {d.faqs.length > 0 && (
    <section class="wrap" id="faq">
      <div class="sh"><h2>Questions {first} gets asked</h2></div>
      <div class="faq">
        {d.faqs.map((f, i) => <details id={`faq-${i + 1}`} open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>
  )}
  {d.photos.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>Courts {first} has built</h2></div>
      <div class="gallery">
        {d.photos.map((p) => (
          <figure class="shot">
            <img src={p.src} alt={`${p.title} by ${d.name}, ${c.name}`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
            <figcaption><b>{p.title}</b>{p.type} · {c.region}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
  <ContactForm builder={b.slug} builderName={d.name} />

  <section class="wrap">
    <div class="sh"><h2>Reviews that name {first}</h2></div>
    {d.reviews.length > 0 ? (
      <div class="revs">
        {d.reviews.map((r) => (
          <figure class="rev">
            <blockquote>“{r.quote}”</blockquote>
            <figcaption><b>{r.author}</b>{r.location && ` · ${r.location}`}{r.project && <span>{r.project}</span>}
              <span>{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.source} review ↗</a> : `${r.source} review`}{r.date && ` · ${r.date}`}</span></figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="empty">Customer reviews that mention {first} by name will appear here once they're checked against the original source.</div>
    )}
  </section>
</Base>

<style>
  .own{font-size:13px;color:var(--mute);margin-top:14px}
  .own a{color:inherit}
  .revs{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .rev{margin:0;border:2px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:14px}
  .rev blockquote{margin:0;font-size:17px;line-height:1.55}
  .rev figcaption{font-family:var(--ui);font-size:13px;display:flex;flex-direction:column;gap:3px;color:var(--mute)}
  .rev figcaption b{color:var(--paper)}
  .rev a{color:var(--teal)}
  .empty{border:2px dashed var(--mute);padding:28px;color:var(--mute);font-size:14px}
  @media (max-width:820px){.revs{grid-template-columns:1fr}}
  .vids{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:18px}
  .vid{position:relative;display:block;aspect-ratio:16/9;overflow:hidden;border:2px solid var(--line)}
  .vid img{width:100%;height:100%;object-fit:cover}
  @media (max-width:820px){.vids{grid-template-columns:1fr 1fr}}
  .portrait img{width:78%;aspect-ratio:1;object-fit:cover;border-radius:50%;border:8px solid var(--ink)}
  .portrait span{font-family:var(--display);font-size:80px;background:var(--ink);width:62%;aspect-ratio:1;border-radius:50%;display:grid;place-items:center}
  .portrait{place-items:center;padding:0}
  .drop-first :global(p){margin:0 0 1em;max-width:62ch}
</style>
