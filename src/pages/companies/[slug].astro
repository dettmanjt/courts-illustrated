---
import { getCollection } from 'astro:content';
import VIDS from '../../data/videos.json';
const mdy = (s: string) => new Date(s + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const lastOf = (dates: (string | undefined)[]) => dates.filter(Boolean).sort().pop();
import Base from '../../layouts/Base.astro';
import Socials from '../../components/Socials.astro';
import ContactForm from '../../components/ContactForm.astro';
import { score, initials } from '../../lib/score';

export async function getStaticPaths() {
  const companies = await getCollection('companies', (c) => c.data.published);
  return companies.map((c) => ({ params: { slug: c.slug }, props: { co: c } }));
}
const { co } = Astro.props;
const c = co.data;
const builders = (await getCollection('builders', (b) => b.data.published && b.data.company.slug === co.slug))
  .map((b) => ({ b, s: score(b.data).total }))
  .sort((x, y) => y.s - x.s);
const avg = builders.length ? Math.round(builders.reduce((a, x) => a + x.s, 0) / builders.length) : 0;
const bslugs = new Set(builders.map((x) => x.b.slug));
const latest = lastOf([...c.videoIds, ...builders.flatMap((x) => x.b.data.videoIds)].map((id) => (VIDS as any)[id]?.date)
  .concat((await getCollection('articles', (a) => a.data.published && bslugs.has(a.data.author.slug))).map((a) => a.data.date)));
const COLORS = ['var(--teal)', 'var(--pink)', 'var(--sun)', 'var(--violet)'];
const url = new URL(`/companies/${co.slug}`, Astro.site).href;
const sameAs = [c.website, ...Object.values(c.socials ?? {})].filter((v, i, a) => v && a.indexOf(v) === i);
const place = (a: any) => a && { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.state, postalCode: a.zip, addressCountry: 'US' };
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeAndConstructionBusiness',
      '@id': `${url}#business`,
      name: c.name,
      url: c.website ?? url,
      description: c.blurb,
      telephone: c.phone,
      email: c.email,
      foundingDate: c.founded,
      address: place(c.address),
      areaServed: c.serviceCities.length ? c.serviceCities.map((n) => ({ '@type': 'Place', name: n })) : c.region,
      knowsAbout: c.services,
      sameAs,
      employee: builders.map(({ b }) => ({ '@type': 'Person', name: b.data.name, jobTitle: b.data.role, url: new URL(`/builders/${b.slug}`, Astro.site).href })),
    },
    c.faqs.length > 0 && {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Courts Illustrated', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: c.name, item: url },
      ],
    },
  ].filter(Boolean),
};
const facts = [
  ['Founded', c.founded],
  ['Headquarters', c.address && [c.address.street, c.address.city, [c.address.state, c.address.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ')],
  ['Phone', c.phone],
  ['Email', c.email],
  ['Hours', c.hours],
  ['Service area', c.serviceCities.length ? c.serviceCities.join(', ') : c.region],
].filter(([, v]) => v);
---
<Base title={`${c.name}, court builder in ${c.region} | Courts Illustrated`} description={c.blurb} jsonld={jsonld}>
  <div class="mast wrap">
    <div class="eyebrow">Company Profile · {c.region}</div>
    <h1>{c.name}</h1>
    <p class="role">{c.blurb}</p>
    <div class="tiles" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="stats">
      <div><b>{builders.length}</b>Builders listed</div>
      <div><b>{avg}</b>Avg. CI score</div>
      {latest && <div><b>{new Date(latest + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</b>Latest content</div>}
    </div>
  </div>

  <section class="wrap">
    <div class="sh"><h2>Company</h2></div>
    <div class="co">
      <div class="co-main">
        <h3>{c.name}</h3>
        <p>Service area: {c.region}</p>
        <div class="chips">{c.services.map((s) => <span>{s}</span>)}</div>
        {c.website && <div class="co-links" style="margin-top:22px"><a class="btn" href={c.website} target="_blank" rel="noopener">Visit {new URL(c.website).hostname} ↗</a></div>}
        <Socials links={c.socials} />
      </div>
    </div>
  </section>


  {c.awards.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>Awards</h2></div>
      <ul class="awards">{c.awards.map((w) => <li><b>{w.year}</b><span>{w.title}</span><small>{w.from}</small></li>)}</ul>
    </section>
  )}

  {(facts.length > 0 || c.stats.length > 0) && (
    <section class="wrap">
      <div class="sh"><h2>At a glance</h2></div>
      <div class="split">
        <ul class="facts">{facts.map(([k, v]) => <li><span>{k}</span>{k === 'Phone' ? <a href={`tel:${String(v).replace(/[^\d]/g, '')}`}>{v}</a> : k === 'Email' ? <a href={`mailto:${v}`}>{v}</a> : v}</li>)}</ul>
        <div>
          {c.stats.length > 0 && <ul class="claims">{c.stats.map((t) => <li>{t}</li>)}</ul>}
          {c.affiliations.length > 0 && <ul class="claims aff">{c.affiliations.map((t) => <li>{t}</li>)}</ul>}
          {c.offices.length > 1 && <ul class="claims">{c.offices.map((o) => <li><b>{o.label}:</b> {[o.street, o.city, o.state].filter(Boolean).join(', ')}{o.phone && ` · ${o.phone}`}</li>)}</ul>}
        </div>
      </div>
    </section>
  )}

  {c.prices.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>What it costs</h2></div>
      <p style="max-width:68ch">{c.name} publishes these prices. That kind of openness is rare in this industry, and it's one of the best signs you're dealing with a builder you can trust.</p>
      <table class="prices">
        <tbody>{c.prices.map((p) => <tr><th scope="row">{p.label}</th><td>{p.text}</td></tr>)}</tbody>
      </table>
      <p class="note">Prices as published by {c.name}{c.checkedOn && `, checked ${c.checkedOn}`}. Your quote depends on your site.</p>
    </section>
  )}

  {c.faqs.length > 0 && (
    <section class="wrap" id="faq">
      <div class="sh"><h2>Questions buyers ask</h2></div>
      <div class="faq">
        {c.faqs.map((f, i) => <details id={`faq-${i + 1}`} open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>
  )}

  {c.projects.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>Notable work</h2></div>
      <ul class="claims">{c.projects.map((t) => <li>{t}</li>)}</ul>
    </section>
  )}

  <section class="wrap">
    <div class="sh"><h2>Builders</h2></div>
    {builders.length === 0 && <p class="note" style="font-size:15px">{c.name}'s builders haven't been listed yet.</p>}
    <div class="team">
      {builders.map(({ b, s }, i) => (
        <a class="member" href={`/builders/${b.slug}`}>
          <div class="av" style={`background:${COLORS[i % COLORS.length]}`}>
            {b.data.photo ? <img src={b.data.photo} alt="" /> : initials(b.data.name)}
          </div>
          <span class="nm">{b.data.name}</span>
          <span class="rl">{b.data.role} · CI score {s}</span>
        </a>
      ))}
    </div>
  </section>

  {c.photos.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>Completed courts</h2></div>
      <div class="gallery">
        {c.photos.map((p) => (
          <figure class="shot">
            <img src={p.src} alt={`${p.title} built by ${c.name}`} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
            <figcaption><b>{p.title}</b>{p.type} · {c.region}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {c.videoIds.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>Videos</h2>{c.socials.youtube && <a class="more" href={c.socials.youtube} target="_blank" rel="noopener">Open channel ↗</a>}</div>
      <div class="vids">
        {c.videoIds.map((id) => { const v = (VIDS as any)[id] || {}; return (
            <figure class="vcard">
              <a class="vid" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener" aria-label={v.title || `Watch a ${c.name} video`}>
                <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
                <span class="play" aria-hidden="true"></span>
              </a>
              <figcaption>{v.title && <h3>{v.title}</h3>}{v.desc && <p>{v.desc}</p>}{v.date && <small>{mdy(v.date)}</small>}</figcaption>
            </figure>
          ); })}
      </div>
    </section>
  )}

  {c.articles.length > 0 && (
    <section class="wrap">
      <div class="sh"><h2>From their blog</h2></div>
      <ul class="alist">
        {c.articles.map((a) => <li><a href={a.url} target="_blank" rel="noopener">{a.title}<span aria-hidden="true">↗</span></a>{a.summary && <p class="asum">{a.summary}</p>}</li>)}
      </ul>
    </section>
  )}

  <ContactForm heading={`Talk to ${c.name}`} />

  {c.sources.length > 0 && (
    <section class="wrap sources">
      <p class="note">Sources: facts on this page come from {c.name}'s own website{c.checkedOn && `, checked ${c.checkedOn}`}: {c.sources.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener">{new URL(u).pathname === '/' ? new URL(u).hostname : new URL(u).pathname}</a></>)}. Spot something out of date? <a href={`/update`}>Request a change</a>.</p>
    </section>
  )}
</Base>

<style>
  .claims{list-style:none;padding:0;margin:0 0 16px;display:grid;gap:8px}
  .claims li{padding-left:18px;position:relative}
  .claims li::before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;background:var(--teal)}
  .claims.aff li::before{background:var(--sun)}
  .prices{width:100%;max-width:760px;border-collapse:collapse;border-top:2px solid var(--line)}
  .prices th,.prices td{text-align:left;padding:12px 8px 12px 0;border-bottom:1px solid var(--line);vertical-align:top}
  .prices th{font-family:var(--ui);font-weight:700;width:45%}
  .sources{padding-block:24px}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .chips span{font-family:var(--ui);font-size:12px;letter-spacing:.06em;text-transform:uppercase;border:2px solid var(--line);padding:6px 10px}
  .team{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid var(--line);border-left:2px solid var(--line)}
  .member{display:flex;flex-direction:column;align-items:center;gap:10px;padding:26px 18px;border-right:2px solid var(--line);border-bottom:2px solid var(--line);text-decoration:none;text-align:center}
  .av{width:120px;height:120px;border-radius:50%;overflow:hidden;display:grid;place-items:center;font-family:var(--display);font-size:44px;color:var(--ink)}
  .av img{width:100%;height:100%;object-fit:cover}
  .nm{font-family:var(--ui);font-weight:700;font-size:19px}
  .rl{font-size:13px;color:var(--mute)}
  @media (max-width:820px){.team{grid-template-columns:1fr 1fr}}
  @media (max-width:480px){.team{grid-template-columns:1fr}}
.awards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .awards li{border:2px solid var(--line);padding:18px;display:grid;gap:6px}
  .awards b{font-family:var(--display);font-weight:400;font-size:40px;line-height:1;color:var(--sun)}
  .awards span{font-family:var(--ui);font-weight:700;font-size:17px;line-height:1.25}
  .awards small{color:var(--mute);font-size:13px}
</style>
